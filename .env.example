# Database — set USE_PGLITE=true for local dev without Docker/PostgreSQL
USE_PGLITE=true
DATABASE_URL=postgresql://campuscommute:campuscommute@localhost:5432/campuscommute

# Redis
REDIS_URL=redis://localhost:6379

# Backend
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ALLOWED_EMAIL_DOMAIN=gim.ac.in

# Resend — for real OTP emails to @gim.ac.in (see README; GIM IT not required)
RESEND_API_KEY=
EMAIL_FROM="CampusCommute <onboarding@resend.dev>"

# Local demo when Resend cannot deliver (shows OTP on screen instead)
ALLOW_DEV_OTP=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
