# Database — local dev uses embedded PGLite (no PostgreSQL required)
USE_PGLITE=true
DATABASE_URL=postgresql://campuscommute:campuscommute@localhost:5432/campuscommute

# Backend
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Auth & security — use strong random values in production
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ALLOWED_EMAIL_DOMAIN=gim.ac.in

# CORS — comma-separated frontend URLs in production (Railway frontend URL)
CORS_ORIGIN=http://localhost:3000

# Resend — optional if using Gmail SMTP below
RESEND_API_KEY=
EMAIL_FROM="CampusCommute <onboarding@resend.dev>"

# Free Gmail SMTP — sends OTP to any @gim.ac.in (no college IT needed)
# 1. Enable 2FA on Gmail → Google Account → Security → App passwords
# 2. Create app password for "Mail"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=CampusCommute <your@gmail.com>

# Local demo when Resend cannot deliver (shows OTP on screen instead)
ALLOW_DEV_OTP=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
