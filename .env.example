# Database — local dev uses embedded PGLite (no PostgreSQL required)
USE_PGLITE=true
DATABASE_URL=postgresql://campuscommute:campuscommute@localhost:5432/campuscommute

# Backend
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Auth & security — use strong random values in production
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ALLOWED_EMAIL_DOMAIN=gim.ac.in

# CORS — comma-separated frontend URLs (required in production)
# Example: https://campuscommute.vercel.app,https://your-preview.vercel.app
CORS_ORIGIN=http://localhost:3000

# Resend — for real OTP emails to @gim.ac.in
RESEND_API_KEY=
EMAIL_FROM="CampusCommute <onboarding@resend.dev>"

# Local demo when Resend is not configured (shows OTP on screen)
ALLOW_DEV_OTP=true

# Frontend — set to your Railway backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Production notes ---
# Railway: add PostgreSQL plugin, set NODE_ENV=production, USE_PGLITE=false (or unset)
# Railway: set CORS_ORIGIN to your Vercel URL(s)
# Railway: set JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY, RESEND_API_KEY
# Railway: set ALLOW_DEV_OTP=false
# Vercel: set NEXT_PUBLIC_API_URL=https://your-app.up.railway.app
